# FlipCar environment variables — copy to .env and fill in values
# Never commit .env to git.

# Supabase (required for caching and persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_KEY=eyJ...

# Telegram (required for --live alerts)
TELEGRAM_BOT_TOKEN=1234567890:ABC...
TELEGRAM_CHAT_ID=677673363

# OpenAI (optional — enables AI listing analysis)
OPENAI_API_KEY=sk-proj-...

# SVV API (optional — vehicle registry lookup)
SVV_API_KEY=...
